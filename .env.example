# --- shell (BFF + host zone) -------------------------------------------------
# Random string, at least 32 characters. Generate with: openssl rand -base64 48
NUXT_SESSION_PASSWORD=change-me-to-a-long-random-secret-at-least-32-chars
# Only when there is no ingress/gateway in front (local, docker compose):
NUXT_LOANS_ZONE_URL=http://localhost:3001
# Mock back-office workflow speed for the live dashboard (0 disables)
NUXT_LOAN_SIMULATOR_INTERVAL_MS=8000

# --- loans zone ---------------------------------------------------------------
# Server-side origin of the BFF/API (cluster-internal service URL in Kubernetes)
NUXT_API_ORIGIN=http://localhost:3000

# --- all zones ----------------------------------------------------------------
NUXT_PUBLIC_IDLE_TIMEOUT_MINUTES=10
